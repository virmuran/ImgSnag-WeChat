<?xml version="1.0" encoding="utf-8"?>
<!--
  ImgSnag 安卓版清单

  两个关键点：

  1) INTERNET 权限 —— 抓公众号文章和图片都要联网。这是唯一需要的权限：
     写相册走的是 MediaStore（Android 10 起应用自己新建的图片不需要任何存储权限），
     所以没有任何 "读写手机存储" 之类的敏感权限，安装时不会吓人。

  2) SEND intent-filter —— 这才是在微信里能直接分享过来的原因。
     微信「分享」发的是纯文本（标题 + 链接），所以匹配 text/plain。
     mimeType 写准很重要：写宽了（如 */*）会出现"分享菜单里有它但点开发不过去"。

  3) networkSecurityConfig —— 界面是从 App 自己起的本地服务加载的
     （http://127.0.0.1:<端口>）。安卓 9 起默认**禁止明文 HTTP**，
     不显式放行的话表现是白屏。注意放行的只有回环地址这一条，
     不是全局开口子（见 res/xml/network_security_config.xml）。

  4) enableOnBackInvokedCallback —— 显式接管**侧边滑动返回**。
     安卓 13 起系统改用 OnBackInvokedDispatcher 派发返回，而 targetSdk 35+
     的应用**默认就走这条路**，`onBackPressed()` 不再被调用 ——
     表现是"侧滑直接退回桌面"，而且改了 onBackPressed 也毫无反应
     （真机上踩过一次）。这里写明 = true 免得有人把 targetSdk 降回去时
     行为悄悄变回去；配套的注册在 MainActivity.setupBack()。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET"/>

    <application
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.DarkActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask">

            <!-- 从桌面图标启动 -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- 从别处「分享」过来（微信、浏览器、笔记App…） -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/plain"/>
            </intent-filter>
        </activity>
    </application>

</manifest>
